{
  "name": "italy-travel-api",
  "version": "1.0.0",
  "private": true,
  "description": "意大利出行小助手 - 云函数版后端（HTTP 访问）",
  "scripts": {
    "build": "esbuild index.ts --bundle --platform=node --target=node20 --format=cjs --outfile=dist/index.js --external:@cloudbase/node-sdk",
    "build:check": "tsc --noEmit",
    "predeploy": "npm run build:check && npm run build"
  },
  "dependencies": {
    "@cloudbase/node-sdk": "3.18.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.12",
    "cors": "^2.8.5",
    "esbuild": "0.27.2",
    "express": "^4.21.2",
    "multer": "^1.4.5-lts.1",
    "typescript": "^5.8.3"
  }
}
